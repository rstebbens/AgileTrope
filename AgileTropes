<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>The Coaching AI Trope Mashup Generator</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #111827;
      color: white;
      margin: 0;
      min-height: 100vh;
    }

    .app {
      text-align: center;
      width: 100%;
      max-width: 900px;
      margin: 0 auto;
      padding: 24px 16px;
      box-sizing: border-box;
    }

    h1 {
      font-size: clamp(28px, 6vw, 42px);
      margin: 0 0 10px;
    }

    .subtitle {
      opacity: 0.7;
      margin-bottom: 24px;
      font-size: clamp(14px, 3vw, 18px);
    }

    .wheels {
      display: flex;
      gap: 18px;
      justify-content: center;
      align-items: stretch;
      margin-bottom: 24px;
      flex-wrap: wrap;
    }

    .wheel {
      background: #1f2937;
      border: 3px solid #374151;
      border-radius: 24px;
      width: min(100%, 300px);
      min-height: 160px;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      box-sizing: border-box;
      font-size: clamp(18px, 4vw, 24px);
      font-weight: bold;
      line-height: 1.25;
      box-shadow: 0 20px 40px rgba(0,0,0,0.35);
      transition: transform 0.2s ease;
    }

    .spinning {
      animation: wobble 0.25s infinite;
    }

    @keyframes wobble {
      0% { transform: rotate(-2deg) scale(1.02); }
      50% { transform: rotate(2deg) scale(1.05); }
      100% { transform: rotate(-2deg) scale(1.02); }
    }

    button {
      background: #22c55e;
      color: #052e16;
      border: none;
      border-radius: 999px;
      padding: 14px 26px;
      font-size: clamp(16px, 4vw, 20px);
      font-weight: bold;
      cursor: pointer;
      max-width: 100%;
      animation: buttonPulse 2.4s ease-in-out infinite;
      box-shadow: 0 0 0 rgba(34, 197, 94, 0.6);
      transition: background 0.2s ease;
    }

    button:hover {
      background: #4ade80;
      animation: buttonTwitch 0.25s ease-in-out infinite;
    }

    @keyframes buttonPulse {
      0% {
        transform: scale(1);
        box-shadow: 0 0 0 rgba(34, 197, 94, 0.35);
      }
      50% {
        transform: scale(1.04);
        box-shadow: 0 0 24px rgba(34, 197, 94, 0.85);
      }
      100% {
        transform: scale(1);
        box-shadow: 0 0 0 rgba(34, 197, 94, 0.35);
      }
    }

    @keyframes buttonTwitch {
      0% { transform: rotate(0deg) scale(1.04); }
      25% { transform: rotate(-1deg) scale(1.05); }
      50% { transform: rotate(1deg) scale(1.04); }
      75% { transform: rotate(-1deg) scale(1.05); }
      100% { transform: rotate(0deg) scale(1.04); }
    }

    .result {
      margin-top: 24px;
      background: #0f172a;
      border: 2px dashed #64748b;
      border-radius: 18px;
      padding: 22px;
      font-size: clamp(20px, 5vw, 28px);
      line-height: 1.35;
      box-sizing: border-box;
      overflow-wrap: break-word;
    }

    @media (max-width: 600px) {
      .app {
        padding: 18px 12px;
      }

      .wheels {
        flex-direction: column;
        align-items: center;
      }

      .wheel {
        width: 100%;
        min-height: 110px;
      }

      .result {
        padding: 18px;
      }
    }
  </style>
</head>

    function randomItem(array) {
      return array[Math.floor(Math.random() * array.length)];
    }

    function spin() {
      const wheel1 = document.getElementById("wheel1");
      const wheel2 = document.getElementById("wheel2");
      const result = document.getElementById("result");

      wheel1.classList.add("spinning");
      wheel2.classList.add("spinning");

      let spins = 0;
      const interval = setInterval(() => {
        wheel1.textContent = randomItem(openings);
        wheel2.textContent = randomItem(tropes);
        spins++;

        if (spins > 18) {
          clearInterval(interval);

          const finalOpening = randomItem(openings);
          const finalTrope = randomItem(tropes);

          wheel1.textContent = finalOpening;
          wheel2.textContent = finalTrope;

          result.textContent = `${finalOpening}. ${finalTrope}`;

          wheel1.classList.remove("spinning");
          wheel2.classList.remove("spinning");
        }
      }, 90);
    }

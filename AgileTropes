<script>
function createBadge() {
  const resultText = document.getElementById("result").innerText;
  const canvas = document.getElementById("badgeCanvas");
  const ctx = canvas.getContext("2d");

  ctx.fillStyle = "#111827";
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  ctx.fillStyle = "#ffffff";
  ctx.font = "bold 54px Arial";
  ctx.textAlign = "center";
  ctx.fillText("AI Coaching Mashup Generator", 600, 90);

  ctx.fillStyle = "#22c55e";
  ctx.font = "bold 34px Arial";
  ctx.fillText("Peak corporate vapour, freshly generated.", 600, 145);

  ctx.strokeStyle = "#64748b";
  ctx.lineWidth = 4;
  ctx.setLineDash([12, 10]);
  ctx.strokeRect(90, 205, 1020, 260);

  ctx.setLineDash([]);
  ctx.fillStyle = "#ffffff";
  ctx.font = "bold 46px Arial";

  wrapText(ctx, `"${resultText}"`, 600, 300, 920, 58);

  ctx.fillStyle = "#94a3b8";
  ctx.font = "26px Arial";
  ctx.fillText("Generated by an entirely unnecessary AI trope machine", 600, 565);

  const link = document.createElement("a");
  link.download = "ai-coaching-mashup-badge.png";
  link.href = canvas.toDataURL("image/png");
  link.click();
}

function wrapText(ctx, text, x, y, maxWidth, lineHeight) {
  const words = text.split(" ");
  let line = "";

  for (let i = 0; i < words.length; i++) {
    const testLine = line + words[i] + " ";
    const metrics = ctx.measureText(testLine);

    if (metrics.width > maxWidth && i > 0) {
      ctx.fillText(line, x, y);
      line = words[i] + " ";
      y += lineHeight;
    } else {
      line = testLine;
    }
  }

  ctx.fillText(line, x, y);
}

